# The chat UI talks to the backend through this server (same-origin
# rewrites in next.config.js); BACKEND_PROXY_TARGET is the proxy target,
# read by the Next SERVER only (not inlined into the client bundle).
# In Docker use the compose service name, e.g. http://app:8000.
BACKEND_PROXY_TARGET=http://localhost:8000

# (Legacy) direct absolute-URL client — only needed if you bypass the proxy:
# NEXT_PUBLIC_API_URL=http://localhost:8000
