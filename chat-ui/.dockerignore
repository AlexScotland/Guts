# =============================================================================
# .dockerignore — chat-ui (Next.js frontend)
# Keeps the Docker build context lean: excludes dependencies, VCS metadata,
# build artifacts, secrets, and local dev noise so only what the image needs
# is sent to the Docker daemon.
# =============================================================================

# --- Dependencies (installed inside the image) -----------------------------
node_modules
**/node_modules

# --- Build output (regenerated by `next build`) ----------------------------
.next
**/.next
out
**/out
dist
**/dist
build
**/build

# --- Version control -------------------------------------------------------
.git
.gitignore
.gitattributes
.github
**/.git

# --- Secrets / local environment -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Logs & OS noise -------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# --- Docker itself (avoid self-reference) ----------------------------------
Dockerfile
Dockerfile.*
docker-compose*.yml
docker-compose*.yaml
.dockerignore

# --- Editor / IDE ----------------------------------------------------------
.vscode
.idea
*.swp
*.swo

# --- Test / coverage artifacts ---------------------------------------------
coverage
.nyc_output
*.test.ts
*.test.tsx
__tests__
**/__tests__

# --- Project-specific local dev artifacts (not part of the frontend build) --
requirements.txt
learning-ai-harness
